# Copy this file to .env and fill in your own values.

# API key from https://openrouter.ai/ — required for the advisor to respond.
OPENROUTER_API_KEY=

# Any model slug OpenRouter supports with tool-calling, e.g. anthropic/claude-sonnet-4.5
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Port the server listens on inside the container.
PORT=3000
